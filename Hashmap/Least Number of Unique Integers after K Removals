import java.util.*;

class Solution {
    public int findLeastNumOfUniqueInts(int[] arr, int k) {
        HashMap<Integer, Integer> map = new HashMap<>();

        for (int num : arr) {
            map.put(num, map.getOrDefault(num, 0) + 1);
        }

        ArrayList<Integer> list = new ArrayList<>(map.values());
        Collections.sort(list);

        int count = list.size();

        for (int freq : list) {
            if (k >= freq) {
                k -= freq;
                count--;
            } else {
                break;
            }
        }

        return count;
    }
}
